doctype html
html(lang="en")
  head
    meta(charset="utf-8")
    meta(name="viewport" content="width=device-width, initial-scale=1")
    title= title
    link(rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css")
    link(rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css")
    link(rel="stylesheet" href="/css/people.css?v=3")
  body
    main.people-page
      header.people-header
        a#back-button.btn.btn-sm.btn-outline-secondary(href="/" aria-label="Back to gallery" title="Back to gallery")
          i.fas.fa-arrow-left
        div.people-heading
          p.people-eyebrow Photo library
          h1 People
        button#scan-button.btn.btn-primary(type="button")
          i.fas.fa-users.me-2
          span#scan-label Scan unprocessed photos

      p.privacy-note(role="note") Face analysis runs in this browser. Descriptors are stored in this gallery database; photo files are not copied.
      p#scan-scope.scope-note(hidden)
      div#status.message-line(role="status" aria-live="polite") Loading face groups...
      div.scan-progress-wrap(aria-live="polite")
        progress#scan-progress(value="0" max="100" aria-label="Face scan progress")
        span#scan-progress-label

      section#reference-section.people-section(aria-labelledby="reference-title" hidden)
        div.section-heading
          h2#reference-title Photo reference
        div#reference-photo-info.group-meta
        button#scan-reference-button.btn.btn-outline-primary(type="button" hidden) Scan reference photo
        div#reference-tag-controls
        div#reference-faces.people-grid

      section.people-section(aria-labelledby="named-title")
        div.section-heading
          h2#named-title Named people
          span#people-count.section-count
        div#people-list.people-grid

      section#person-match-section.people-section(hidden aria-labelledby="person-match-title")
        div.section-heading
          h2#person-match-title Possible matches
          span#person-match-count.section-count
        div#person-match-list.people-grid

      section.people-section(aria-labelledby="suggestions-title")
        div.section-heading.suggestions-heading
          div
            h2#suggestions-title Suggested groups
            span#suggestion-count.section-count
          label.threshold-control(for="similarity-threshold")
            span Similarity
            input#similarity-threshold(type="range" min="0.5" max="0.99" step="0.01" value="0.88")
            output#similarity-value(for="similarity-threshold") 0.88
        p#truncated-note.warning-note(hidden) Showing up to 500 unassigned faces. Assign groups to load the next set.
        div#suggestion-list.people-grid
        button#show-more.btn.btn-outline-secondary(type="button" hidden) Show more groups

    datalist#person-name-options
    script(src="/face-runtime.js")
    script(src="/js/people.js?v=5")